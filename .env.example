# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORGANIZATION_ID=your_organization_id_here

# OpenAI Model Configuration (Optional - defaults provided)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=200
OPENAI_TEMPERATURE=0.7

# Text-to-Speech Configuration (Optional - defaults provided)
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Speech-to-Text Configuration (Optional - defaults provided)
OPENAI_STT_MODEL=whisper-1

# Camera Configuration (Optional - defaults provided)
CAMERA_INDEX=0
TARGET_FPS=30

# Blush Analysis Thresholds (Optional - defaults provided)
STRONG_DELTA_A=4.0
UNEVEN_DELTA_A=3.0
COVERAGE_RATIO=0.8
RED_A_THRESHOLD=135.0